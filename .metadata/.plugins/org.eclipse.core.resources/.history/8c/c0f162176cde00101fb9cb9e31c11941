	public float GrantTotal() {
		float GrandTotal = 0f;
		for(GetSet s:list) {
			GrandTotal += s.getTotal();
		}
		return GrandTotal;
	}
	public String Search(String  c) {
		List<String> result = new ArrayList<String>();
		for(GetSet g:list) {
			if(g.getProducts_Name().equals(c)) {
				System.out.println(g.getCount());
				result.add(g.getProducts_Name()) ;
			}
		}
		return result.toString();
