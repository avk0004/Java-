package mini;
import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;
public class MiniDAo {

	List<GetSet> list = new ArrayList<GetSet>();
	List<GetSetAdmin> admins = AdminDAO.getAdminList();
	private AdminDAO adminDAO;
	private int Count=1;
	public MiniDAo(AdminDAO adminDAO) {
        this.adminDAO = adminDAO;
    }
	
//Adding products
	public List<GetSet> AddProduct (String ProductName, float Quantity) {
		List<GetSetAdmin> admins = adminDAO.getAdminList();

		for(int i=0;i<admins.size();i++) {
			GetSetAdmin ga = admins.get(i);
			boolean found  =false;
			if(ga.getPName().equals(ProductName)) {
				float total = ga.getMRPrice() *Quantity;
				list.add(new GetSet(Count++, ProductName, ga.getMRPrice(), Quantity, total));
				float remaining = ga.getAvailableQ() - Quantity;
				admins.set(i, new GetSetAdmin(remaining,ga.getMRPrice(),ga.getPName()));
				found = true;
				
			}
			if(!found) {
				System.out.println("Sorry that product is not available");
			}
		}
		return list;
	}
//Displaying Products list
	public void Display() {
		for(GetSet s:list) {
			System.out.println(s.getCount()+" "+s.getProducts_Name()+" "+s.getPrice()+" "+s.getQuantity()+" "+s.getTotal());
		}
	}
//removing Items
	public boolean remove(String ProductName, Float Quantity ) {
		for(int i=0;i<admins.size();i++) {
			GetSetAdmin ga = admins.get(i);
			boolean found  =false;
			if(ga.getPName().equals(ProductName)) {
				float total = ga.getMRPrice() *Quantity;
				list.add(new GetSet(Count++, ProductName, ga.getMRPrice(), Quantity, total));
				float remaining = ga.getAvailableQ() + Quantity;
				admins.remove(i, new GetSetAdmin(remaining,ga.getMRPrice(),ga.getPName()));
				found = true;
				
			}
			if(!found) {
				System.out.println("Sorry that product is not available");
			}
		}
		return false;
	}
