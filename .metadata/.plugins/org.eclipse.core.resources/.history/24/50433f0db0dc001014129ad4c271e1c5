package mini;

import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;


public class MiniDAo {
	List<GetSet> list = new ArrayList<GetSet>();
	private int Count=1;
	public List AddProduct (String ProductName, float Price, float Quantity) {
		float total = Price *Quantity;
		list.add(new GetSet(Count++, ProductName, Price, Quantity, total));
		return list;

	}
	public void Display() {
		for(GetSet s:list) {
			System.out.println(s.getCount()+" "+s.getProducts_Name()+" "+s.getPrice()+" "+s.getQuantity()+" "+s.getTotal());
		}
	}
	public boolean remove(int c) {
		Iterator<GetSet> itr = list.iterator();
		while(itr.hasNext()) {
			GetSet g = itr.next();
			if(g.getCount() == c) {
				itr.remove();
				System.out.println("Item removed");
				return true;
				
			}
		}
		System.out.println("no Item removed");
		return false;
	}
	public boolean update(int c, String str, float price, float quantity) {
		for(GetSet g:list) {
			if(g.getCount() == c) {
				g.setProducts_Name(str);
				g.setPrice(price);
				g.setQuantity(quantity);
				return true;
			}
		}
		
		return false;
	}
	public float GrantTotal() {
		float GrandTotal = 0f;
		for(GetSet s:list) {
			GrandTotal += s.getTotal();
		}
		return GrandTotal;
	}
	public GetSet Search(int c) {
		for(GetSet g:list) {
			if(g.getCount() == c) {
				return 	g;		
			}
		return null;
		}
		return null;
		
	}
	public void Delete() {
		list.clear();
		System.out.println("deleted");
	}
}
