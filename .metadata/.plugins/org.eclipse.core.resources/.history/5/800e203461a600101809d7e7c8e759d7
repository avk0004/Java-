package p1;
import java.util.*;
public class Main1 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner sc = new Scanner(System.in);
		System.out.println("Enter a number");
		int n = sc.nextInt();
		int a =0; 
		for(int i=1;i<=n;i++) {
			for(int j=1;j<=i;j++) {
				++a;
				System.out.print(a);
			}
			System.out.println();
		}
	}

}
