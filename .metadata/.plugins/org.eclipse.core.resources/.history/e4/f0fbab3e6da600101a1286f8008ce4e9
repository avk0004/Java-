package p1;
import java.util.*;
public class Squarefree {
	public static void main(String[] args) {
		Scanner sc = new Scanner (System.in);
		int n = sc.nextInt();
		int count =0;
		for(int i=1;i<n;i++) {
			boolean c= false;
			for(int j=2;j<i;j++) {
				if(n%j ==0) {


						c = true;
						break;


			}
			if( c==true) {
				count++;
			}
		}
	}
		System.out.println(count);

	}
}
