package mini;
import java.util.*;
public class AdminDAO {
	List<GetSetAdmin> Admin;
	List<GetSet> list = new ArrayList<>();
	public List<GetSetAdmin> Available(Float availableQ, Float mRPrice , String PName) {
		Admin.add(new GetSetAdmin( availableQ, mRPrice,PName));
		return Admin;
	}
	public void AdminShow() {
		for(GetSetAdmin admin:Admin) {
			System.out.println("Product Name"+admin.PName+ "Available Quantity"+ admin.AvailableQ+
					"Price"+admin.MRPrice);
		}
	}
	public void RemainQ() {
		MiniDAo m = new MiniDAo();
		 for (int i = 0; i < Admin.size(); i++) {
		        GetSetAdmin ga = Admin.get(i);
			for(GetSet s:list) {
				if(ga.PName.equals(s.getProducts_Name())) {
					float r = ga.AvailableQ - s.getQuantity();
					Admin.set(
		                    i,
		                    new GetSetAdmin(ga.getMRPrice(), r, ga.getPName())
		                );
				}
				
			}
			System.out.print(i.getPName());

		}
		}
	

}
