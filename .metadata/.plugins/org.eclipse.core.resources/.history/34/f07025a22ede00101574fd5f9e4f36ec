package mini;
import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;
public class MiniDAo {

	List<GetSet> list = new ArrayList<GetSet>();
	 private AdminDAO adminDAO;
	private int Count=1;
	public MiniDAo(AdminDAO adminDAO) {
        this.adminDAO = adminDAO;
    }
	
//Adding products
	public List<GetSet> AddProduct (String ProductName, float Price, float Quantity) {
		List<GetSetAdmin> admins = adminDAO.getAdminList();

		for(int i=0;i<admins.size();i++) {
			GetSetAdmin ga = admins.get(i);
			if(ga.getPName().equals(ProductName)) {
				float total = Price *Quantity;
				list.add(new GetSet(Count++, ProductName, Price, Quantity, total));
				float remaining = ga.getAvailableQ() - Quantity;
				admins.set(i, new GetSetAdmin(remaining,ga.getMRPrice(),ga.getPName()));
				
			}
		}
		return list;
	}
	public void Display() {
		for(GetSet s:list) {
			System.out.println(s.getCount()+" "+s.getProducts_Name()+" "+s.getPrice()+" "+s.getQuantity()+" "+s.getTotal());
		}
	}
	public boolean remove(int c) {
		Iterator<GetSet> itr = list.iterator();
		while(itr.hasNext()) {
			GetSet g = itr.next();
			if(g.getCount() == c) {
				System.out.println(g.getProducts_Name());
				itr.remove();
				System.out.println("Item removed");
				return true;
			}
		}
		System.out.println("no Item removed");
		return false;
	}
	public boolean update(int c, String str, float price, float quantity) {
		for(GetSet g:list) {
			if(g.getCount() == c) {
				g.setProducts_Name(str);
				g.setPrice(price);
				g.setQuantity(quantity);
				return true;
			}
		}
		
		return false;
	}
	public float GrantTotal() {
		float GrandTotal = 0f;
		for(GetSet s:list) {
			GrandTotal += s.getTotal();
		}
		return GrandTotal;
	}
	public String Search(String  c) {
		List<String> result = new ArrayList<String>();
		for(GetSet g:list) {
			if(g.getProducts_Name().equals(c)) {
				System.out.println(g.getCount());
				result.add(g.getProducts_Name()) ;
			}
		}
		return result.toString();
	}
	public void Delete() {
		list.clear();
		System.out.println("deleted");
	}
}
